[Unit]
Description=DiPlay-Pi Native AirPlay RTSP Receiver for Wireless CarPlay
After=NetworkManager.service network.target diplay-hotspot.service diplay-pi.service
Wants=diplay-hotspot.service diplay-pi.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/diplay
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:+UseSerialGC -jar /opt/diplay/bin/diplay-airplay.jar 7000 7001 7002 /opt/diplay/auth
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
