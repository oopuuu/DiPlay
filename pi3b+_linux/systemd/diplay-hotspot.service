[Unit]
Description=DiPlay-Pi Guaranteed Hotspot Bootstrapper
After=NetworkManager.service
Wants=NetworkManager.service
Before=diplay-pi.service diplay-airplay.service

[Service]
Type=oneshot
User=root
RemainAfterExit=yes
ExecStart=/bin/bash /opt/diplay/scripts/ensure_hotspot.sh

[Install]
WantedBy=multi-user.target
